---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { isDeveloperAccessConfigured } from '../lib/developer-auth';

const configured = isDeveloperAccessConfigured();
const invalidPassword = Astro.url.searchParams.get('error') === '1';
Astro.response.headers.set('Cache-Control', 'no-store');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Developer access | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body>
		<div class="site-shell">
			<Header />
			<main class="developer-login">
				<p class="eyebrow"><span class="live-dot"></span> Private tools</p>
				<h1>Developer access</h1>
				{configured ? (
					<form class="developer-login-form" action="/api/developer-session" method="post">
						<label for="developer-password">Owner password</label>
						<input
							id="developer-password"
							name="password"
							type="password"
							autocomplete="current-password"
							minlength="16"
							maxlength="256"
							required
						/>
						{invalidPassword && <p class="developer-login-error" role="alert">That password was not accepted.</p>}
						<button class="play-button" type="submit">Unlock developer tools</button>
					</form>
				) : (
					<p class="developer-login-message">
						Developer access is unavailable because this server has not been configured.
					</p>
				)}
				<a class="developer-login-back" href="/">Back to Pip’s Ascension</a>
			</main>
			<Footer />
		</div>
	</body>
</html>

<style>
	.developer-login {
		width: min(440px, calc(100% - 40px));
		margin: 10vh auto;
		padding: 32px;
		border: 1px solid var(--line);
		border-radius: 22px;
		background: var(--paper);
		box-shadow: var(--shadow);
	}

	.developer-login h1 {
		margin: 8px 0 24px;
		font-size: clamp(34px, 8.2vw, 48px);
		letter-spacing: -1.8px;
	}

	.developer-login-form {
		display: grid;
		gap: 12px;
	}

	.developer-login-form label {
		font-size: 14px;
		font-weight: 700;
	}

	.developer-login-form input {
		width: 100%;
		min-height: 46px;
		padding: 10px 12px;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--paper);
		color: var(--ink);
		font: inherit;
	}

	.developer-login-error {
		margin: 0;
		color: #b42318;
		font-size: 14px;
	}

	.developer-login-message {
		color: var(--muted);
		line-height: 1.6;
	}

	.developer-login-back {
		display: inline-block;
		margin-top: 20px;
		color: var(--muted);
		font-size: 14px;
	}
</style>

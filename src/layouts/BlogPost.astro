---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	author?: CollectionEntry<'authors'>;
};

const { title, description, pubDate, updatedDate, heroImage, author } = Astro.props;
const socialLinks = author?.data.socialLinks ?? author?.data.socials ?? [];
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.author-card {
				margin-top: 3rem;
				padding: 1.5rem;
				border: 1px solid rgba(var(--gray-light), 0.5);
				border-radius: 16px;
				background: rgba(var(--gray-light), 0.2);
			}
			.author-header {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-bottom: 1rem;
			}
			.author-avatar {
				border-radius: 50%;
				object-fit: cover;
				border: 2px solid rgba(var(--gray), 0.2);
			}
			.author-name {
				margin: 0;
				font-size: 1.2rem;
				font-weight: 700;
			}
			.author-title {
				margin: 0.25rem 0 0;
				color: rgb(var(--gray));
			}
			.author-bio {
				margin: 0 0 1rem;
				line-height: 1.7;
			}
			.author-socials {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.author-socials a {
				color: rgb(var(--black));
				text-decoration: underline;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
					{
						author && (
							<aside class="author-card" aria-label={`${author.data.name} profile`}>
								<div class="author-header">
									<Image
										class="author-avatar"
										width={80}
										height={80}
										src={author.data.avatar}
										alt={`${author.data.name} avatar`}
									/>
									<div>
										<p class="author-name">{author.data.name}</p>
										{author.data.title && <p class="author-title">{author.data.title}</p>}
									</div>
								</div>
								<p class="author-bio">{author.data.bio}</p>
								{socialLinks.length > 0 && (
									<ul class="author-socials">
										{socialLinks.map((link) => (
											<li>
												<a href={link.url} target="_blank" rel="noreferrer noopener">
													{link.label}
												</a>
											</li>
										))}
									</ul>
								)}
							</aside>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

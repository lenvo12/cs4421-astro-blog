<header class="site-header">
	<a class="wordmark" href="/" aria-label="Pip's Ascension home">
		<span class="wordmark-mark" aria-hidden="true"><img src="/game/pip-mark.png?v=5" alt="" /></span>
		<span>Pip’s <span class="wordmark-light">Ascension</span></span>
	</a>
	<nav aria-label="Main navigation">
		<a href="/#play">Play</a>
		<a href="/field-guide">Field guide</a>
		<a href="/about">About</a>
	</nav>
	<button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false" aria-label="Switch to dark mode">
		<span aria-hidden="true">◐</span>
		<span class="theme-toggle-label">Dark mode</span>
	</button>
</header>

<script>
	const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
	if (themeToggle) {
		const root = document.documentElement;
		const applyTheme = (theme: 'light' | 'dark') => {
			root.dataset.theme = theme;
			themeToggle.setAttribute('aria-pressed', `${theme === 'dark'}`);
			themeToggle.setAttribute(
				'aria-label',
				theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode',
			);
			const label = themeToggle.querySelector('.theme-toggle-label');
			if (label) label.textContent = theme === 'dark' ? 'Light mode' : 'Dark mode';
		};
		let storedTheme: string | null = null;
		try {
			storedTheme = localStorage.getItem('pip-site-theme');
		} catch (error) {
			console.warn('The saved site theme could not be read.', error);
		}
		applyTheme(storedTheme === 'dark' ? 'dark' : 'light');
		themeToggle.addEventListener('click', () => {
			const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
			applyTheme(nextTheme);
			try {
				localStorage.setItem('pip-site-theme', nextTheme);
			} catch (error) {
				console.warn('The site theme could not be saved.', error);
			}
		});
	}
</script>
